{
  "description": "Your gateway to web3 text-based adventures and arcade games.",
  "secrets": [],
  "governance": {
    "approvers": "invited",
    "approvals": {
      "atLeast": 1
    }
  },
  "tests": [
    {
      "id": "arcade.default",
      "name": "Arcade catalog renders",
      "path": "/#/",
      "expectSelector": ".arcade",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Creator Studio renders for an allowed account",
      "path": "/#/admin",
      "expectSelector": "#admin-title"
    },
    {
      "name": "Game preview renders",
      "path": "/#/embed/timun-suri",
      "expectText": "EMBED SOURCE"
    },
    {
      "name": "Title details render",
      "path": "/#/title/timun-suri",
      "expectText": "Distance gap"
    },
    {
      "name": "Briefing shows before a fresh run",
      "path": "/#/play/timun-suri",
      "expectSelector": "[data-testid='briefing']",
      "expectText": "Opening scene",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Runner mid-run demo state",
      "path": "/#/play/neon-syndicate?demo=1",
      "expectText": "NEURAL INTEGRITY"
    }
  ]
}
