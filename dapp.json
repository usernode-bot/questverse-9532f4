{
  "description": "A simulated retro PC: games, saves, and a DOS-style prompt.",
  "icon": {
    "image": "brand/icon-2.jpg"
  },
  "secrets": [],
  "governance": {
    "approvers": "invited",
    "approvals": {
      "atLeast": 1
    }
  },
  "tests": [
    {
      "id": "rig.desktop",
      "name": "Rig desktop and Start menu render",
      "path": "/#/",
      "expectSelector": "[data-start]",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Game Collection lists both built-in titles",
      "path": "/#/collection",
      "expectSelector": "[data-built-in] [data-title=\"deepwatch\"]"
    },
    {
      "name": "Game Collection shows the catalogue form",
      "path": "/#/collection",
      "expectText": "Catalogued, not executed"
    },
    {
      "name": "Memory Card lists four slots for each built-in title",
      "path": "/#/memory",
      "expectSelector": "[data-card=\"mandate\"] [data-slot=\"mandate:4\"]"
    },
    {
      "name": "Keyboard shows the joystick mapping",
      "path": "/#/keyboard",
      "expectSelector": "[data-mapping] [data-action=\"confirm\"]"
    },
    {
      "name": "Settings shows the picture sliders",
      "path": "/#/settings",
      "expectSelector": "[data-setting=\"scanline\"]"
    },
    {
      "name": "Prompt answers VER with the rig version",
      "path": "/#/prompt",
      "expectText": "RetroRig DOS shell, simulated"
    },
    {
      "name": "Deepwatch runs on the rig",
      "path": "/#/play/deepwatch",
      "expectSelector": "[data-game-canvas=\"deepwatch\"]"
    },
    {
      "name": "Mandate of Seasons runs on the rig",
      "path": "/#/play/mandate",
      "expectSelector": "[data-game-canvas=\"mandate\"]"
    },
    {
      "name": "Deepwatch how-to-play screen renders",
      "path": "/#/how/deepwatch",
      "expectSelector": "[data-how-to-title=\"deepwatch\"]"
    },
    {
      "name": "Mandate of Seasons how-to-play screen renders",
      "path": "/#/how/mandate",
      "expectSelector": "[data-how-to-title=\"mandate\"]"
    }
  ]
}
