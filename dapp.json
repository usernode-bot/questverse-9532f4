{
  "description": "Your gateway to web3 text-based adventures and arcade games.",
  "icon": {
    "image": "brand/icon.jpg"
  },
  "secrets": [],
  "governance": {
    "approvers": "invited",
    "approvals": {
      "atLeast": 1
    }
  },
  "tests": [
    {
      "id": "arcade.default",
      "name": "Arcade catalog renders",
      "path": "/#/",
      "expectSelector": ".arcade",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Creator Studio renders for an allowed account",
      "path": "/#/admin",
      "expectSelector": "#admin-title"
    },
    {
      "name": "Seasonal theme picker renders in Creator Studio",
      "path": "/#/admin",
      "expectSelector": "[data-theme-picker] [data-theme-option=\"halloween\"]"
    },
    {
      "name": "Background music uploader renders on each choice in Creator Studio",
      "path": "/#/admin",
      "expectSelector": "[data-music-editor] [data-trigger=\"timun-suri:0:A\"] [data-music-upload]"
    },
    {
      "name": "Prelude story field renders in the Creator Studio form",
      "path": "/#/admin",
      "expectSelector": "#admin-prelude"
    },
    {
      "name": "Game preview renders",
      "path": "/#/embed/timun-suri",
      "expectText": "EMBED SOURCE"
    },
    {
      "name": "Title details render",
      "path": "/#/title/timun-suri",
      "expectText": "Distance gap"
    },
    {
      "name": "Runner starts a title",
      "path": "/#/play/timun-suri",
      "expectText": "DISTANCE GAP: MODERATE"
    },
    {
      "name": "Runner mid-run demo state",
      "path": "/#/play/neon-syndicate?demo=1",
      "expectText": "NEURAL INTEGRITY"
    }
  ]
}
