{
  "description": "A simulated LCD handheld GameWatch: a catalog of original arcade titles with an auto-sliding hero banner, a manager that edits every title, a Memory Card and a dashboard of simulated modules.",
  "icon": {
    "image": "brand/icon-2.jpg"
  },
  "secrets": [],
  "governance": {
    "approvers": "invited",
    "approvals": {
      "atLeast": 1
    }
  },
  "tests": [
    {
      "id": "gw.arcade",
      "name": "Arcade: the hero banner, the category pills and the catalog rows",
      "path": "/#/",
      "expectSelector": "[data-gallery]",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "name": "Arcade renders the hero banner",
      "path": "/#/",
      "expectSelector": "[data-hero]"
    },
    {
      "name": "The hero banner names a title",
      "path": "/#/",
      "expectSelector": "[data-hero-title]"
    },
    {
      "name": "The hero badge reads PLATFORM: GAMEWATCH",
      "path": "/#/",
      "expectSelector": "[data-hero-badge]",
      "expectText": "PLATFORM: GAMEWATCH"
    },
    {
      "name": "The hero banner can be edited",
      "path": "/#/",
      "expectSelector": "[data-hero-edit]"
    },
    {
      "name": "Arcade offers a category pill",
      "path": "/#/",
      "expectSelector": "[data-catalog-pill=\"Simulation\"]"
    },
    {
      "name": "The category pill narrows the catalogue",
      "path": "/#/?pill=Simulation",
      "expectSelector": "[data-gallery][data-filter=\"Simulation\"]"
    },
    {
      "name": "A filtered catalogue shows a simulation row",
      "path": "/#/?pill=Simulation",
      "expectSelector": "[data-cat-row=\"airforce-fighter\"]"
    },
    {
      "name": "Arcade shows the seeded western-bar catalog row",
      "path": "/#/",
      "expectSelector": "[data-cat-row=\"western-bar\"]"
    },
    {
      "name": "The catalog row shows the handheld thumbnail",
      "path": "/#/",
      "expectSelector": "[data-cat-thumb=\"western-bar\"]"
    },
    {
      "name": "The catalog row names the platform",
      "path": "/#/",
      "expectSelector": "[data-cat-row=\"western-bar\"] [data-cat-platform=\"western-bar\"]"
    },
    {
      "name": "The seeded titles reach the Arcade",
      "path": "/#/",
      "expectSelector": "[data-cat-row=\"sl-bankman\"]"
    },
    {
      "name": "Arcade has an add-game footer",
      "path": "/#/",
      "expectSelector": "[data-add-game-foot]"
    },
    {
      "name": "Arcade header carries the module menu button",
      "path": "/#/",
      "expectSelector": "[data-header-menu]"
    },
    {
      "name": "The manager renders every title",
      "path": "/#/manage",
      "expectSelector": "[data-manage-panel]"
    },
    {
      "name": "The manager lists the seeded built-in titles",
      "path": "/#/manage",
      "expectSelector": "[data-manage-title-row=\"western-bar\"]"
    },
    {
      "name": "The manager has an editor for each title",
      "path": "/#/manage",
      "expectSelector": "[data-manage-edit=\"western-bar\"]"
    },
    {
      "name": "The manager opens the banner editor",
      "path": "/#/manage/banner",
      "expectSelector": "[data-manage-slide=\"0\"]"
    },
    {
      "name": "Hungry Dragon how to play screen renders",
      "path": "/#/how/hungry-dragon",
      "expectSelector": "[data-how-to-title=\"hungry-dragon\"]"
    },
    {
      "name": "Terminal says it is simulated",
      "path": "/#/terminal",
      "expectText": "simulated"
    },
    {
      "name": "Terminal help lists ufw",
      "path": "/#/terminal",
      "expectText": "print the simulated firewall install transcript"
    },
    {
      "name": "FTP shows the read-only file tree",
      "path": "/#/ftp",
      "expectSelector": "[data-ftp-tree]"
    },
    {
      "name": "FTP tree lists the games directory",
      "path": "/#/ftp",
      "expectText": "/ games"
    },
    {
      "name": "OS lists the panel skins",
      "path": "/#/os",
      "expectSelector": "[data-os-skins]"
    },
    {
      "name": "OS says it is simulated",
      "path": "/#/os",
      "expectText": "Simulated OS"
    },
    {
      "name": "Features states the two-month retention",
      "path": "/#/features",
      "expectText": "two months"
    },
    {
      "name": "Features offers the Install UFW action",
      "path": "/#/features",
      "expectSelector": "[data-install-ufw-run]"
    },
    {
      "name": "Settings shows the curvature slider",
      "path": "/#/settings",
      "expectSelector": "[data-setting=\"curvature\"]"
    },
    {
      "name": "Settings still shows the scanline slider",
      "path": "/#/settings",
      "expectSelector": "[data-setting=\"scanline\"]"
    },
    {
      "name": "Settings shows the handheld key mapping",
      "path": "/#/settings",
      "expectSelector": "[data-mapping] [data-action=\"game_a\"]"
    },
    {
      "name": "Key mapping binds all nine handheld keys",
      "path": "/#/settings",
      "expectSelector": "[data-mapping] [data-action=\"reset\"]"
    },
    {
      "name": "Admin panel renders",
      "path": "/#/admin",
      "expectSelector": "[data-admin-panel]"
    },
    {
      "name": "Title runs on the LCD panel: western-bar",
      "path": "/#/play/western-bar",
      "expectSelector": "[data-lcd-canvas=\"western-bar\"]"
    },
    {
      "name": "Title runs on the LCD panel: battle-field",
      "path": "/#/play/battle-field",
      "expectSelector": "[data-lcd-canvas=\"battle-field\"]"
    },
    {
      "name": "Title runs on the LCD panel: airforce-fighter",
      "path": "/#/play/airforce-fighter",
      "expectSelector": "[data-lcd-canvas=\"airforce-fighter\"]"
    },
    {
      "name": "Title runs on the LCD panel: guerrilla-warfare",
      "path": "/#/play/guerrilla-warfare",
      "expectSelector": "[data-lcd-canvas=\"guerrilla-warfare\"]"
    },
    {
      "name": "Title runs on the LCD panel: submarine-battle",
      "path": "/#/play/submarine-battle",
      "expectSelector": "[data-lcd-canvas=\"submarine-battle\"]"
    },
    {
      "name": "Title runs on the LCD panel: space-attacker",
      "path": "/#/play/space-attacker",
      "expectSelector": "[data-lcd-canvas=\"space-attacker\"]"
    },
    {
      "name": "Title runs on the LCD panel: hungry-dragon",
      "path": "/#/play/hungry-dragon",
      "expectSelector": "[data-lcd-canvas=\"hungry-dragon\"]"
    },
    {
      "name": "Title runs on the LCD panel: sl-bankman",
      "path": "/#/play/sl-bankman",
      "expectSelector": "[data-lcd-canvas=\"sl-bankman\"]"
    }
  ]
}
